# Normalize all text files to LF in repo AND working tree, whatever the OS / core.autocrlf.
# Stops hundreds of 'modified' files and merge conflicts caused by CRLF vs LF.
* text=auto eol=lf

# Keep binary files byte-for-byte. Without this, Git on Windows (core.autocrlf=true) rewrote line
# endings inside many PNGs, which corrupted them (most images in Frontend/src/**/assets were broken).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.p12  binary
